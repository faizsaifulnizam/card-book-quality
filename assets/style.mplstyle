# Six-on-SG series matplotlib style — v0.1.3 (hex colors double-quoted; legend auto-placed — 'best')
font.family: sans-serif
font.sans-serif: Inter, DejaVu Sans, sans-serif
font.size: 10
text.color: "#14293D"
axes.titlesize: 13
axes.titlelocation: left
axes.titlepad: 14
axes.labelsize: 10
axes.labelcolor: "#5C6B79"
axes.edgecolor: "#E7E3DC"
axes.linewidth: 0.8
axes.spines.top: False
axes.spines.right: False
axes.grid: True
axes.grid.axis: y
grid.color: "#E7E3DC"
grid.linewidth: 0.6
axes.prop_cycle: cycler("color", ["#22607B", "#C0552B", "#2E7D6B", "#8A6EAF", "#B9975B", "#5C6B79"])
xtick.color: "#5C6B79"
ytick.color: "#5C6B79"
xtick.labelsize: 9
ytick.labelsize: 9
figure.facecolor: "#FBFBF9"
axes.facecolor: "#FBFBF9"
savefig.facecolor: "#FBFBF9"
savefig.dpi: 200
figure.figsize: 8, 4.5
legend.frameon: False
legend.loc: best
legend.fontsize: 9
